<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ sistem açılış ekranı launch_background'ı göstermez; kendi
         API'si: zemin rengi + ikon. İkon olarak adaptive ön plan katmanı
         kullanılır (aynı güvenli bölge kuralı). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/acilis_zemin</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
